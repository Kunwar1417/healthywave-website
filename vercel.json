{
  "redirects": [
    {
      "source": "/desk",
      "destination": "/desk/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/book",
      "destination": "/book.html"
    },
    {
      "source": "/desk/",
      "destination": "https://healthywave-desk.fly.dev/"
    },
    {
      "source": "/desk/:path*",
      "destination": "https://healthywave-desk.fly.dev/:path*"
    }
  ],
  "functions": {
    "api/book.mjs": {
      "maxDuration": 30
    }
  }
}
